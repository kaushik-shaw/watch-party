# YouTube IFrame API Script URL
NEXT_PUBLIC_YOUTUBE_IFRAME_API_URL=https://www.youtube.com/iframe_api

# Optional: Google YouTube Data API Key
NEXT_PUBLIC_YOUTUBE_API_KEY=

# Backend Socket.IO Server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Backend Server Port
PORT=4000

# PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/watchparty?schema=public"
