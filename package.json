{
  "name": "watch-party",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "server": "tsx watch --env-file=.env server/index.ts",
    "server:watch": "tsx watch --env-file=.env server/index.ts",
    "server:build": "prisma generate",
    "server:start": "prisma generate && tsx server/index.ts",
    "server:deploy": "prisma db push && prisma generate && tsx server/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "next": "16.4.3",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3"
  }
}
